# Volcengine Ark model endpoint
ARK_MODEL_ID=ep-xxxxxxxxxxxxxxxx

# Preferred authentication mode
ARK_API_KEY=

# Alternative AK/SK authentication mode; configure both or neither
ARK_ACCESS_KEY=
ARK_SECRET_KEY=

# Optional Ark settings
ARK_BASE_URL=
ARK_REGION=
ARK_TIMEOUT=60s
ARK_RETRY_TIMES=2
ARK_THINKING=auto
ARK_MAX_TOOL_CALLS=8
ARK_PARALLEL_TOOL_CALLS=true

# Vardiel runtime settings
VARDIEL_HTTP_ALLOW_PRIVATE=false
VARDIEL_TLS_ALLOW_PRIVATE=false
VARDIEL_DOCKER_SOCKET=/var/run/docker.sock
VARDIEL_KUBECONFIG=
VARDIEL_KUBERNETES_CONTEXT=
VARDIEL_PROMETHEUS_URL=
VARDIEL_PROMETHEUS_ALLOW_HTTP=false
VARDIEL_PROMETHEUS_BEARER_TOKEN_FILE=
VARDIEL_LOKI_URL=
VARDIEL_LOKI_ALLOW_HTTP=false
VARDIEL_LOKI_BEARER_TOKEN_FILE=
VARDIEL_LOKI_TENANT_ID=
VARDIEL_SYSTEM_PROMPT=
VARDIEL_EVENTS=none

# Optional OpenTelemetry OTLP/HTTP tracing
VARDIEL_OTEL_ENABLED=false
OTEL_SERVICE_NAME=vardiel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
